        "mainEntity": [
          {
            "@type": "Question",
            "name": "Hangi tür temizlik yapıyorsunuz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Oturulan ev, çalışan ofis ve apartman ortak alanlarında iç temizlik yapıyoruz. Odak noktamız yaşamaya ve çalışmaya uygun mekânlardır."
            }
          },
          {
            "@type": "Question",
            "name": "Hangi mahallelere geliyorsunuz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Konyaaltı’nın 39, Muratpaşa’nın 55 ve Kepez’in 68 mahallesine geliyoruz. Mahalle adını randevu mesajında yazmanız yeterli."
            }
          },
          {
            "@type": "Question",
            "name": "Nasıl randevu alırım?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "+90 (533) 097 89 24 veya +90 (505) 068 03 07 numarasına WhatsApp’tan yazın. İlçe, mahalle, oda sayısı ya da ofis metrekaresi ve istediğiniz günü belirtin. İletişim formunu doldurursanız mesaj aynı hatta açılır."
            }
          },
          {
            "@type": "Question",
            "name": "Pazar günü de geliyor musunuz?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet. Hat haftanın 7 günü, günün her saati açıktır. Ekip, anlaştığımız saatte adrese gelir."
            }
          },
          {
            "@type": "Question",
            "name": "Malzeme ve ekipman sizden mi?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Evet. Ekip temizlik malzemesi ve ekipmanıyla gelir. Evinizde belirli bir ürün kullanılmasını istiyorsanız randevu mesajında yazın."
            }
          },
          {
            "@type": "Question",
            "name": "Ücret nasıl belli olur?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yayınlanmış sabit fiyat listemiz yok. Oda sayısı, banyo sayısı, evin durumu ve işin tek sefer ya da haftalık olması ücreti değiştirir. Bu bilgileri WhatsApp’tan yazın; rakamı mesajda netleştirelim."
            }
          }
        ]
